#
#Microkinetic model parameters
#

rxn_expressions = [
               '*_s + CH2OHCHOHCH2OH_g -> CH2OHCHOHCH2OH*',
               '*_s + O2_g -> O2*',
               '*_s + H2O_g -> H2O*',
               '*_s + O2* + H2O* <-> 2OH* + O*',
               'CH2OHCHOHCH2OH* + OH* <-> CH2OHCHOHCH2O* + H2O*',
               'CH2OHCHOHCH2O* + *_s -> CH2OHCHOHCHO* + H*',
               'CH2OHCHOHCHO* + OH* <-> CH2OHCHOHCHOOH* + H*',
               'CH2OHCHOHCHOOH* + *_s <-> CH2OHCHOHCOOH* + H*',
               '2H* + O* <-> H2O*',
               'CH2OHCHOHCOOH* -> CH2OHCHOHCOOH_g + *_s',
               'H2O* -> H2O_g + *_s'
                   ]


surface_names = ['ceo2', 'cuo', 'tio2', 'zno', 'zro2', 'sio2'] #surfaces to include in scaling (need to have descriptors defined for each)

descriptor_names= ['c_s','o_s'] #descriptor names

descriptor_ranges = [[-5,2],[-5,2]]

resolution = 8

temperature = 333 #Temperature of the reaction

species_definitions = {}
species_definitions['RCH2OH_g'] = {'pressure':0.8} #define the gas pressures
species_definitions['O2_g'] = {'pressure':0.1}
species_definitions['H2O_g'] = {'pressure':0.1}
species_definitions['RCOOH_g'] = {'pressure':0.68}

species_definitions['s'] = {'site_names': ['111'], 'total':1} #define the sites

data_file = 'gly_oxidation.pkl'

#
#Parser parameters
#

input_file = 'energies.txt' #input data

#
#Scaler parameters
#

gas_thermo_mode = "fixed_entropy_gas"
#gas_thermo_mode = "ideal_gas" #Ideal gas approximation
#gas_thermo_mode = "zero_point_gas" #uses zero-point corrections only
#gas_thermo_mode = "fixed_entropy_gas" #assumes entropy of 0.002 eV/K for all gasses except H2 (H2 is 0.00135 eV/K)
#gas_thermo_mode = "frozen_gas" #neglect thermal contributions

adsorbate_thermo_mode = "frozen_adsorbate"
#adsorbate_thermo_mode = "harmonic_adsorbate"
#adsorbate_thermo_mode = "hindered_adsorbate"
#adsorbate_thermo_mode = "zero_point_adsorbate"

scaling_constraint_dict = {
                           'C_s':['+',0,None],
                           'O_s':[0,'+',None],
                           }


#
#Solver parameters
#

decimal_precision = 100 #precision of numbers involved

tolerance = 1e-50 #all d_theta/d_t's must be less than this at the solution

max_rootfinding_iterations = 100

max_bisections = 3

