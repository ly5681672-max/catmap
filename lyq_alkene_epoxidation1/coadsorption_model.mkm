# NEB-consistent coadsorption model. Provisional kinetics, not validated TOFs.
rxn_expressions = [
    '* + H2O2_g + C6H12_g <-> R*',
    'R* <-> RP* -> P*',
    'P* <-> C6H12O_g + H2O_g + *',
]
surface_names = ['tife','timn','tihf','tire','tinb','timo','tiv','tizr','tico','titi','tiw','tita','ticr','ti','tini']
temperature = 333.15
species_definitions = {}
species_definitions['C6H12_g'] = {'pressure': 1.0}
species_definitions['H2O2_g'] = {'pressure': 0.185}
species_definitions['H2O_g'] = {'pressure': 0.815}
species_definitions['C6H12O_g'] = {'pressure': 1e-20}
species_definitions['s'] = {'site_names': ['111'], 'total': 1}
for sp in ['R_s', 'P_s', 'RP_s']:
    species_definitions[sp] = {'composition': {'C': 6, 'H': 14, 'O': 2}}
input_file = 'energies.txt'
data_file = 'coadsorption_model.pkl'
gas_thermo_mode = 'frozen_gas'
adsorbate_thermo_mode = 'frozen_adsorbate'
pressure_mode = 'static'
descriptor_names = ['R_s', 'P_s']
descriptor_ranges = [[-30,0],[-30,0]]
resolution = 10
