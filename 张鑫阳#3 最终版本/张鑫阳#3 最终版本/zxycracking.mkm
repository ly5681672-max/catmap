#
#Microkinetic model parameters
#

rxn_expressions = [

               '*_s + C6H14_g -> C6H14*', 
               '*_s + C6H14* <-> C6H13-H* + *_s -> C6H13* + H*',
               'C6H13* + H* <-> CH3CH2CH-C3H8* + *_s -> CH3CH2CH* + C3H8*',
               'CH3CH2CH* <-> CH3CHCH-H* -> C3H6* ',
               'C3H6*  -> C3H6_g + *_s',
               'C3H8*  -> C3H8_g + *_s',
                   ]


surface_names = ['FeZSM5', 'CoZSM5', 'NiZSM5', 'CuZSM5', 'ZnZSM5', 'PtZSM5' ,'AgZSM5', 'AuZSM5'] #surfaces to include in scaling (need to have descriptors defined for each)

descriptor_names= ['H_s','CH3CH2CH_s'] #descriptor names

descriptor_ranges = [[-2,4],[1,-3]]

resolution = 12

temperature = 873 #Temperature of the reaction

species_definitions = {}
species_definitions['C6H14_g'] = {'pressure':1.} #define the gas pressures
species_definitions['C3H6_g'] = {'pressure':0.05}
species_definitions['C3H8_g'] = {'pressure':0.05}

species_definitions['s'] = {'site_names': ['111'], 'total':1} #define the sites

data_file = 'zxy cracking.pkl'

#
#Parser parameters
#

input_file = 'zxyenergies.txt' #input data

#
#Scaler parameters
#

gas_thermo_mode = "fixed_entropy_gas"
#gas_thermo_mode = "ideal_gas" #Ideal gas approximation
#gas_thermo_mode = "zero_point_gas" #uses zero-point corrections only
#gas_thermo_mode = "fixed_entropy_gas" #assumes entropy of 0.002 eV/K for all gasses except H2 (H2 is 0.00135 eV/K)
#gas_thermo_mode = "frozen_gas" #neglect thermal contributions

adsorbate_thermo_mode = "frozen_adsorbate"
#adsorbate_thermo_mode = "harmonic_adsorbate"
#adsorbate_thermo_mode = "hindered_adsorbate"
#adsorbate_thermo_mode = "zero_point_adsorbate"

scaling_constraint_dict = {
                           'H_s':['+',0,None],
                           'CH3CH2CH_s':[0,'+',None],
                          # 'C6H13-H_s':'initial_state',
                          # 'CH3CH2CH-C3H8_s':'final_state',
                          # 'CH3CHCH-H_s':'final_state'
                           }


#
#Solver parameters
#

decimal_precision = 100 #precision of numbers involved

tolerance = 1e-50 #all d_theta/d_t's must be less than this at the solution

max_rootfinding_iterations = 100

max_bisections = 3

