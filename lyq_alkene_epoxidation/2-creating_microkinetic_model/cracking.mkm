#
# Microkinetic model parameters
#

rxn_expressions = [
    '* + H2O2_g <-> H2O2*',
    'H2O2* + * -> Ha* + OOH*',
    '* + C6H12_g <-> C6H12*',
    'OOH* + C6H12* + * <-> OOH-C6H12* + 2* -> C6H12O* + O* + Hb*',
    'C6H12O* <-> C6H12O_g + *',
    'Hb* + O* <-> Hb-O* + * -> OH* + *',
    'Ha* + OH* -> * + H2O*',
    'H2O* <-> H2O_g + *',
]

surface_names = ['tife', 'cuo', 'tio2', 'zno', 'zro2', 'sio2']

descriptor_names = ['c_s', 'o_s']
descriptor_ranges = [[-5, 2], [-5, 2]]
resolution = 8

temperature = 333

species_definitions = {}

# 当前体系的气相压力；如实际实验条件不同，请按真实条件修改。
species_definitions['H2O2_g'] = {'pressure': 0.8}
species_definitions['C6H12_g'] = {'pressure': 0.1}
species_definitions['H2O_g'] = {'pressure': 0.1}
species_definitions['C6H12O_g'] = {'pressure': 0.0}

species_definitions['s'] = {'site_names': ['111'], 'total': 1}

# Ha/Hb 不是合法化学式，而是不同位置的吸附 H；显式定义元素组成。
species_definitions['Ha_s'] = {'composition': {'H': 1}}
species_definitions['Hb_s'] = {'composition': {'H': 1}}
species_definitions['Hb-O_s'] = {'composition': {'H': 1, 'O': 1}}

data_file = 'gly_oxidation.pkl'

#
# Parser parameters
#

input_file = 'energies.txt'

#
# Scaler parameters
#

gas_thermo_mode = 'fixed_entropy_gas'
adsorbate_thermo_mode = 'frozen_adsorbate'

scaling_constraint_dict = {
    'C_s': ['+', 0, None],
    'O_s': [0, '+', None],
}

#
# Solver parameters
#

decimal_precision = 100
tolerance = 1e-50
max_rootfinding_iterations = 100
max_bisections = 3
