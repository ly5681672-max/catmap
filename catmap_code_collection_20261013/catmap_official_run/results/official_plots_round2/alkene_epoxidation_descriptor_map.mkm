# Isolated official CatMAP 0.3.1 descriptor-grid model for native analyze plots.
# Source energies.txt is a read-only copy of the already validated input table.
rxn_expressions = [
    '* + H2O2_g + C6H12_g <-> Rpair*',
    'Rpair* <-> TS1* -> EpoxideHHO*',
    'EpoxideHHO* <-> HHO* + C6H12O_g',
    'HHO* <-> TS2* -> OHHa*',
    'OHHa* <-> H2O*',
    'H2O* <-> H2O_g + *',
]

# Only the 13 sites with previously verified steady-state results are used as
# scaler anchors. Ti-Zr remains unresolved and is intentionally excluded.
surface_names = [
    'tife', 'timn', 'tihf', 'tire', 'timo', 'tiv', 'tico',
    'titi', 'tiw', 'tita', 'ticr', 'ti', 'tini',
]

# Official 2-D descriptor scan. Axes are the existing formation energies of
# the explicit NEB1 transition state and its epoxide-containing product state.
descriptor_names = ['TS1_s', 'EpoxideHHO_s']
descriptor_ranges = [[-34.566395, -32.451521], [-36.841013, -34.837773]]
resolution = [15, 15]
descriptor_decimal_precision = 6
avoid_scaling = True

temperature = 333.15
pressure = 1.0
pressure_mode = 'concentration'
species_definitions = {}
species_definitions['s'] = {'site_names': ['active'], 'total': 1}
species_definitions['H2O2_g'] = {'concentration': 0.185}
species_definitions['C6H12_g'] = {'concentration': 1.0}
species_definitions['H2O_g'] = {'concentration': 0.815}
species_definitions['C6H12O_g'] = {'concentration': 1e-20}
species_definitions['Rpair_s'] = {'composition': {'C': 6, 'H': 14, 'O': 2}, 'n_sites': 1}
species_definitions['TS1_s'] = {'composition': {'C': 6, 'H': 14, 'O': 2}, 'n_sites': 1}
species_definitions['EpoxideHHO_s'] = {'composition': {'C': 6, 'H': 14, 'O': 2}, 'n_sites': 1}
species_definitions['HHO_s'] = {'composition': {'H': 2, 'O': 1}, 'n_sites': 1}
species_definitions['TS2_s'] = {'composition': {'H': 2, 'O': 1}, 'n_sites': 1}
species_definitions['OHHa_s'] = {'composition': {'H': 2, 'O': 1}, 'n_sites': 1}
species_definitions['H2O_s'] = {'composition': {'H': 2, 'O': 1}, 'n_sites': 1}

input_file = 'energies.txt'
parser = 'TableParser'
scaler = 'GeneralizedLinearScaler'
solver = 'SteadyStateSolver'
gas_thermo_mode = 'frozen_gas'
adsorbate_thermo_mode = 'frozen_adsorbate'
estimate_frequencies = False
output_variables = [
    'coverage', 'rate', 'turnover_frequency', 'production_rate', 'selectivity',
]
data_file = 'catmap_descriptor_grid.pkl'
log_file = 'catmap_descriptor_grid.log'
